    FontJustificationV JUSTIFYTOP,
}

Frame "FRAME" "ItrStatLine" {
    Width 0.184,
    Height 0.0175,
    Frame "TEXT" "ItrStatName" {
        DecorateFileNames,
        Width 0.116,
        Height 0.0175,
        UseActiveContext,
        SetPoint LEFT, "ItrStatLine", LEFT, 0.0, 0.0,
        FrameFont "MasterFont", 0.009, "",
        FontColor 1.0 1.0 1.0 1.0,
        FontJustificationH JUSTIFYLEFT,
        FontJustificationV JUSTIFYMIDDLE,
    }
    Frame "TEXT" "ItrStatValue" {
        DecorateFileNames,
        Width 0.062,
        Height 0.0175,
        UseActiveContext,
        SetPoint RIGHT, "ItrStatLine", RIGHT, 0.0, 0.0,
        FrameFont "MasterFont", 0.009, "",
        FontColor 0.5 1.0 0.5 1.0,
        FontJustificationH JUSTIFYRIGHT,
        FontJustificationV JUSTIFYMIDDLE,
    }
}

