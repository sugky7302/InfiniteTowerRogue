{
    "name": "Infinite Tower",
    "version": "0.1.0",
    "description": "一款基於 Rogue 模式的魔獸爭霸3地圖，玩家需要在無盡的塔中不斷挑戰怪物，獲取裝備和技能，提升自己的實力，最終挑戰最終BOSS。",
    "author": "Arvin Yang",
    "license": "MIT",
    "main": "src/main.ts",
    "scripts": {
        "format": "prettier --write src scripts tests package.json .prettierrc.json \".vscode/*.json\"",
        "format:check": "prettier --check src scripts tests package.json .prettierrc.json \".vscode/*.json\"",
        "test": "ts-node --transpile-only scripts/test.ts",
        "test:unit": "tsc --noEmit -p tsconfig.test.json && ts-node --transpile-only --project tsconfig.test.json -r tsconfig-paths/register tests/run.ts",
        "test:skill:lua": "node scripts/verify-skill-lua.cjs",
        "test:skill:artifact": "ts-node --transpile-only --project tsconfig.test.json -r tsconfig-paths/register tests/skill/artifact.spec.ts",
        "test:benchmark:lua": "node scripts/verify-benchmark-lua.cjs",
        "test:benchmark:artifact": "ts-node --transpile-only --project tsconfig.test.json tests/rxwc3/benchmark-artifact.spec.ts",
        "bench:auto": "node scripts/run-bench.cjs",
        "bench:decode": "node scripts/decode-bench.cjs",
        "bench:lua": "node scripts/benchmark-lua.cjs",
        "test:i18n:lua": "node scripts/verify-i18n-lua.cjs && node scripts/verify-file-io-lua.cjs",
        "test:i18n:artifact": "ts-node --transpile-only --project tsconfig.test.json tests/i18n/artifact.spec.ts",
        "build": "ts-node --transpile-only scripts/build.ts",
        "dev": "npm-watch",
        "build:defs": "ts-node scripts/dev",
        "test:save:lua": "node scripts/verify-save-lua.cjs",
        "test:save:artifact": "ts-node --transpile-only --project tsconfig.test.json tests/hero-save/artifact.spec.ts",
        "lint:fsd": "steiger ./src",
        "test:combat:lua": "node scripts/verify-combat-lua.cjs",
        "test:hero:lua": "node scripts/verify-hero-lua.cjs",
        "test:hero:artifact": "ts-node --transpile-only --project tsconfig.test.json tests/hero/artifact.spec.ts",
        "test:combat:artifact": "ts-node --transpile-only --project tsconfig.test.json tests/combat/artifact.spec.ts"
    },
    "dependencies": {
        "w3ts": "^3.0.2"
    },
    "devDependencies": {
        "@feature-sliced/steiger-plugin": "0.8.2",
        "@types/fs-extra": "11.0.4",
        "@types/node": "22.15.17",
        "@types/pako": "2.0.3",
        "@typescript-to-lua/language-extensions": "1.19.0",
        "fs-extra": "11.3.0",
        "lua-types": "^2.13.1",
        "luamin": "^1.0.4",
        "mdx-m3-viewer-th": "^5.13.3",
        "npm-watch": "0.13.0",
        "prettier": "3.9.10",
        "steiger": "0.9.0",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "tsutils": "3.21.0",
        "typescript": "5.9.3",
        "typescript-to-lua": "1.34.0",
        "war3-objectdata-th": "^0.2.11",
        "war3-transformer": "^3.0.10",
        "war3-types-strict": "^0.1.3",
        "war3tstlhelper": "1.0.1",
        "winston": "^3.17.0"
    },
    "watch": {
        "build:defs": {
            "patterns": [
                "./maps/*"
            ],
            "extensions": "lua",
            "legacyWatch": true
        }
    }
}
