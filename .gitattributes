# 自動判斷文字檔案，並將儲存庫內容正規化為 LF。
* text=auto

# 格式化範圍中的程式與工具設定固定使用 LF。
*.ts text eol=lf
*.cjs text eol=lf
/.vscode/*.json text eol=lf
/package.json text eol=lf
/.prettierrc.json text eol=lf

# TOC 實驗依賴實際位元組。主檔固定 CRLF，探測檔不得新增換行。
/assets/ui/infinite-tower-rogue.toc text eol=crlf
/assets/ui/itr-probe-no-trailing.toc -text
