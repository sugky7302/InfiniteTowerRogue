{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src/shared",
    "outDir": "./dist/rxwc3",
    "plugins": [],
    "types": ["war3-types-strict/1.33.0"]
  },
  "include": ["src/shared/rxwc3/**/*.ts"],
  "tstl": {
    "luaTarget": "5.3",
    "noHeader": true,
    "luaLibImport": "require",
    "noImplicitSelf": true,
    "luaBundle": "rxwc3.lua",
    "luaBundleEntry": "./src/shared/rxwc3/index.ts"
  }
}
