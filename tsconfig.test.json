{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "baseUrl": "./",
    "paths": {
      "@features/*": ["./src/features/*"],
      "@entities/*": ["./src/entities/*"],
      "@shared/*": ["./src/shared/*"]
    },
    "types": ["node", "war3-types-strict/1.33.0"],
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/shared/**/*.ts", "tests/**/*.ts"]
}
